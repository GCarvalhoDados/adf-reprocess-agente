ANTHROPIC_API_KEY=sk-ant-...

# Auth Azure — az CLI tem prioridade; Service Principal é fallback
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-secret

# Target ADF
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_RESOURCE_GROUP=my-resource-group
ADF_FACTORY_NAME=my-data-factory

# Operacional (opcionais, defaults abaixo)
# ADF_POLL_INTERVAL_SECONDS=15   — intervalo entre polls de status
# ADF_RUN_TIMEOUT_SECONDS=7200   — timeout máximo por run (2h)
